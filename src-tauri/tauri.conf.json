{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jira People Board",
  "version": "0.1.0",
  "identifier": "dev.jirapeopleboard.app",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Jira People Board",
        "width": 1280,
        "height": 880,
        "minWidth": 420,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
